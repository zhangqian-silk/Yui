{
  "name": "@zq-silk/yui",
  "version": "0.4.1",
  "description": "Local control plane for long-running native agent CLI sessions backed by tmux.",
  "license": "MIT",
  "private": true,
  "publishConfig": {
    "registry": "https://registry.invalid/"
  },
  "type": "module",
  "bin": {
    "yui": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "README.md",
    "ARCHITECTURE.md",
    "i18n/README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "env -u FORCE_COLOR -u YUI_TEST_KEEP_SESSION_ENV -u YUI_TEST_TIER -u YUI_TEST_PRIVILEGED_MANIFEST NO_COLOR=1 node --import ./test/helpers/scrubSessionEnv.js --test test/*.test.js test/core/*.test.js",
    "test:tier": "node scripts/run-test-tier.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "seed:web": "npm run build && node scripts/seed-web-dashboard.mjs",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "prepublishOnly": "node scripts/refuse-source-publish.mjs",
    "pack:dry-run": "npm run build && node scripts/assemble-runtime-package.mjs --output .release-stage && npm pack ./.release-stage --dry-run --ignore-scripts --cache ./.npm-cache"
  },
  "engines": {
    "node": "^20.17.0 || ^22.9.0 || ^24.0.0"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "libc": [
    "glibc"
  ],
  "keywords": [
    "yui",
    "tmux",
    "cli",
    "agents",
    "codex",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangqian-silk/Yui.git"
  },
  "bugs": {
    "url": "https://github.com/zhangqian-silk/Yui/issues"
  },
  "homepage": "https://github.com/zhangqian-silk/Yui#readme",
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "smol-toml": "1.7.0",
    "ws": "^8.21.1"
  }
}
