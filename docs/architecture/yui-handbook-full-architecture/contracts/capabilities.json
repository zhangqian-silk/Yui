{
  "status": "design-catalog",
  "notes": [
    "命名为目标契约示意，实施可适配现有CLI路径。",
    "所有actor由可信入口获得；下列authority说明不是可由参数声明的权限。",
    "effects以声明能力的最大可能范围分类，纯本地分支可复用事务而不复制账本。",
    "call桥解析目标descriptor后采用其真实effect和权限，桥自身不授予任何额外权限。"
  ],
  "capabilities": [
    {
      "name": "task.create",
      "summary": "建立一个目标及其 Draft",
      "version": "1",
      "effect": "local-mutation",
      "inputSchema": {
        "type": "object",
        "required": [
          "title",
          "objective"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          }
        }
      },
      "outputContract": "TaskRecord",
      "authority": "user/operator",
      "requestIdRequired": true
    },
    {
      "name": "task.read",
      "summary": "读取任务事实",
      "version": "1",
