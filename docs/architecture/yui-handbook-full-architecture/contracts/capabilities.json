                  "afterPlanningTurnId"
                ],
                "properties": {
                  "afterPlanningTurnId": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      },
      "outputContract": "OperationRef",
      "authority": "user/operator/leader",
      "requestIdRequired": true
