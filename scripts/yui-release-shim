#!/bin/sh
# Yui stable launcher shim (Issue 02).
#
# This shim is the single stable `yui` entrypoint. It resolves the Home's
# active release pointer and execs that release's CLI, so `which yui` never
# resolves into a Git worktree or npm link. When no active release pointer
# exists (a legacy Home that has never activated a release), it falls back to
# the legacy `yui-legacy` binary on PATH.
#
# Rollback: `yui release activate <previous-release>` atomically switches the
# pointer; the next invocation resolves the previous release.

set -eu

YUI_HOME_RESOLVED="${YUI_HOME:-$HOME/.yui}"
POINTER="$YUI_HOME_RESOLVED/runtime/active-release.json"

if [ -f "$POINTER" ]; then
  RELEASE_ID=$(YUI_POINTER="$POINTER" node -e '
    const fs = require("node:fs");
    const pointer = JSON.parse(fs.readFileSync(process.env.YUI_POINTER, "utf8"));
    if (
      pointer === null
      || typeof pointer !== "object"
      || typeof pointer.releaseId !== "string"
      || pointer.releaseId.length === 0
    ) {
      process.stderr.write("Yui active release pointer is invalid.\n");
      process.exit(5);
    }
    process.stdout.write(pointer.releaseId);
  ')
  RELEASE_DIR="$YUI_HOME_RESOLVED/runtime/releases/$RELEASE_ID"
  if [ ! -f "$RELEASE_DIR/dist/cli.js" ]; then
    printf 'Yui active release %s is not installed.\n' "$RELEASE_ID" >&2
    exit 5
  fi

  # A cross-release activation must be driven by the target release. Its
  # candidate grace and the enclosing promotion deadline are one versioned
  # contract; the active release may carry an older, shorter timeout. Resolve
  # only an explicit target here. A no-argument activation remains with the
  # active CLI so it can resume the release named by the current pointer.
  ACTIVATE_TARGET=""
  if [ "$#" -eq 3 ] && [ "$1" = "release" ] && [ "$2" = "activate" ]; then
    ACTIVATE_TARGET="$3"
  elif [ "$#" -eq 4 ]; then
    if [ "$1" = "--json" ] && [ "$2" = "release" ] && [ "$3" = "activate" ]; then
      ACTIVATE_TARGET="$4"
    elif [ "$1" = "release" ] && [ "$2" = "--json" ] && [ "$3" = "activate" ]; then
      ACTIVATE_TARGET="$4"
    elif [ "$1" = "release" ] && [ "$2" = "activate" ] && [ "$3" = "--json" ]; then
      ACTIVATE_TARGET="$4"
    elif [ "$1" = "release" ] && [ "$2" = "activate" ] && [ "$4" = "--json" ]; then
      ACTIVATE_TARGET="$3"
    fi
  fi

  if [ -n "$ACTIVATE_TARGET" ]; then
    # Use the already-trusted active release to verify installed release
    # integrity and the smoke receipt before executing any target code. The
    # target CLI then repeats its normal activation-time integrity check.
    TARGET_RELEASE_ID=$(
      node "$RELEASE_DIR/dist/cli.js" release list --json |
        node -e '
          let input = "";
          process.stdin.setEncoding("utf8");
          process.stdin.on("data", (chunk) => { input += chunk; });
          process.stdin.on("end", () => {
            try {
              const envelope = JSON.parse(input);
              const releases = envelope?.data?.releases;
              if (envelope?.ok !== true || !Array.isArray(releases)) {
                throw new Error("release list returned no verified release catalog");
              }
              const requested = process.argv[1];
              const exact = releases.find((release) => release?.releaseId === requested);
              const selected = exact
                ?? releases.find((release) => release?.buildId === requested);
              if (
                selected?.smoke !== true
                || typeof selected.releaseId !== "string"
                || selected.releaseId.length === 0
                || selected.releaseId.includes("/")
                || selected.releaseId.includes("\\")
                || selected.releaseId === "."
                || selected.releaseId === ".."
              ) {
                process.stderr.write(
                  `Yui target release ${requested} is not installed, verified, and smoke-checked.\n`
                );
                process.exit(5);
                return;
              }
              process.stdout.write(selected.releaseId);
            } catch (error) {
              process.stderr.write(
                `Yui active release could not verify the target activation driver: ${error.message}\n`
              );
              process.exit(5);
            }
          });
        ' "$ACTIVATE_TARGET"
    )
    TARGET_RELEASE_DIR="$YUI_HOME_RESOLVED/runtime/releases/$TARGET_RELEASE_ID"
    if [ ! -f "$TARGET_RELEASE_DIR/dist/cli.js" ]; then
      printf 'Yui verified target release %s is unavailable.\n' "$TARGET_RELEASE_ID" >&2
      exit 5
    fi
    exec node "$TARGET_RELEASE_DIR/dist/cli.js" "$@"
  fi

  exec node "$RELEASE_DIR/dist/cli.js" "$@"
fi

# Legacy fallback: no active release pointer.
exec yui-legacy "$@"
